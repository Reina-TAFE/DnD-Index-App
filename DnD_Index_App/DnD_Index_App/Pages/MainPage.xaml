<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DnD_Index_App.Pages.MainPage"
             xmlns:pages="clr-namespace:DnD_Index_App.Pages"
             
             x:DataType="pages:MainPage"
             Shell.NavBarIsVisible="False"
             Title="Home Page"
             BackgroundColor="{DynamicResource CurrentBackgroundColour}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Stack Orientation Style -->
            <Style TargetType="FlexLayout" x:Key="StackStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Direction" Value="Column" />
                                    <Setter Property="JustifyContent" Value="SpaceBetween" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                    <Setter Property="VerticalOptions" Value="Fill" />
                                    <Setter Property="AlignItems" Value="Stretch" />
                                    <Setter Property="Padding" Value="35, 0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Direction" Value="Row" />
                                    <Setter Property="JustifyContent" Value="SpaceEvenly" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                    <Setter Property="VerticalOptions" Value="Fill" />
                                    <Setter Property="AlignItems" Value="Center" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Border" x:Key="BodyStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="2" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="0" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                    <Setter Property="WidthRequest" Value="411" />
                                    <Setter Property="VerticalOptions" Value="Fill" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="4" />
                                    <Setter Property="VerticalOptions" Value="Fill" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Border" x:Key="HeaderStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="0" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                    <Setter Property="WidthRequest" Value="411" />
                                    <Setter Property="VerticalOptions" Value="Fill" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="4" />
                                    <Setter Property="VerticalOptions" Value="Fill" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="SpellButtonStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Text" Value="Spells" />
                                    <Setter Property="FontSize" Value="28" />
                                    <Setter Property="HeightRequest" Value="90" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ImageSource" Value="cleric_symbol.png" />
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="HeightRequest" Value="192" />
                                    <Setter Property="WidthRequest" Value="192" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="ClassButtonStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Text" Value="Classes" />
                                    <Setter Property="FontSize" Value="28" />
                                    <Setter Property="HeightRequest" Value="90" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ImageSource" Value="paladin.png" />
                                    <Setter Property="HeightRequest" Value="192" />
                                    <Setter Property="WidthRequest" Value="192" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="EquipmentButtonStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Text" Value="Equipment" />
                                    <Setter Property="FontSize" Value="28" />
                                    <Setter Property="HeightRequest" Value="90" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ImageSource" Value="fighter_symbol.png" />
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="HeightRequest" Value="192" />
                                    <Setter Property="WidthRequest" Value="192" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="RuleButtonStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Text" Value="Rules" />
                                    <Setter Property="FontSize" Value="28" />
                                    <Setter Property="HeightRequest" Value="90" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ImageSource" Value="scroll.png" />
                                    <Setter Property="Text" Value="" />
                                    <Setter Property="HeightRequest" Value="192" />
                                    <Setter Property="WidthRequest" Value="192" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <!-- Grid Orientation Style -->
            <Style TargetType="Grid" x:Key="GridStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="RowDefinitions" Value="auto,0.5*,3*,auto" />
                                    <Setter Property="ColumnDefinitions" Value="auto" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="RowDefinitions" Value="auto,*" />
                                    <Setter Property="ColumnDefinitions" Value="*,*,*,*" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Grid" x:Key="NavGridStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="IsVisible" Value="True" />
                                    <Setter Property="Grid.Row" Value="3" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="0" />
                                    <Setter Property="HorizontalOptions" Value="Fill" />
                                    <Setter Property="WidthRequest" Value="411" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="IsVisible" Value="False" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Border" x:Key="LogoStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <!-- Portrait Stack Orientation Style -->
                            <VisualState x:Name="Portrait">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Portrait" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="0" />
                                    
                                    <Setter Property="Grid.Column" Value="0" />

                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Landscape">
                                <VisualState.StateTriggers>
                                    <OrientationStateTrigger Orientation="Landscape" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="0" />

                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="HorizontalOptions" Value="Center"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Border 
        StrokeThickness="0"
            StrokeShape="RoundRectangle 15"
            HorizontalOptions="Fill" VerticalOptions="Fill">
        <ScrollView
            BackgroundColor="{DynamicResource CurrentBackgroundColour}" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid Style="{StaticResource GridStyle}" HorizontalOptions="Fill" VerticalOptions="Fill" >
                <Border Grid.Row="0" Grid.Column="0" StrokeThickness="0" HorizontalOptions="Fill" Style="{StaticResource HeaderStyle}">
                    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image 
                            Grid.Column="0"
                            Margin="15, 10, 15, 0"
                            x:Name="SettingsBtn"
                            Source="settings_icon.png"
                            VerticalOptions="Start"
                            HorizontalOptions="Start"
                            BackgroundColor="{DynamicResource CurrentBackgroundColour}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="SettingsBtnTapped"
                                    NumberOfTapsRequired="1"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Column="1"
                            Source="app_logo.png"
                            HeightRequest="126"
                            WidthRequest="126"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            SemanticProperties.Description="App logo" 
                            Margin="5,35,0,10"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" StrokeThickness="0" HorizontalOptions="Fill" VerticalOptions="Fill" Style="{StaticResource BodyStyle}">
                <FlexLayout Direction="Column"  HorizontalOptions="Fill" VerticalOptions="Fill" 
                            AlignItems="Center" JustifyContent="SpaceEvenly" Style="{StaticResource StackStyle}">
                    <Button
                        
                    x:Name="SpellsBtn"
                    Style="{StaticResource SpellButtonStyle}"
                    Margin="0, 10, 0, 5"
                    Text="Spells"
                    FontSize="{Binding BodyFontSize}"
                    BorderWidth="2"
                    TextColor="{DynamicResource CurrentButtonTextColour}"                
                    BorderColor="#000000"
                    BackgroundColor="{DynamicResource CurrentButtonColour}"
                    SemanticProperties.Hint="Counts the number of times you click"

                    HorizontalOptions="Fill"
                    HeightRequest="90">
                        <Button.GestureRecognizers>
                            <TapGestureRecognizer
                            Tapped="SearchBtn_Tapped"
                            NumberOfTapsRequired="1"/>
                        </Button.GestureRecognizers>
                    </Button>

                    <Button
                        
                    x:Name="ClassesBtn"
                    Style="{StaticResource ClassButtonStyle}"
                    Margin="0, 0, 0, 5"
                    Text="Classes" 
                    FontSize="32"
                    BorderWidth="2"
                    TextColor="{DynamicResource CurrentButtonTextColour}"                
                    BorderColor="#000000"
                    BackgroundColor="{DynamicResource CurrentButtonColour}"
                    SemanticProperties.Hint="Counts the number of times you click"

                    HorizontalOptions="Fill"
                    HeightRequest="90" >
                        <Button.GestureRecognizers>
                            <TapGestureRecognizer
                            Tapped="SearchBtn_Tapped"
                            NumberOfTapsRequired="1"/>
                        </Button.GestureRecognizers>
                    </Button>

                    <Button
                        
                    x:Name="EquipmentBtn"
                    Style="{StaticResource EquipmentButtonStyle}"
                    Margin="0, 0, 0, 5"
                    Text="Equipment"
                    FontSize="32"
                    BorderWidth="2"
                    TextColor="{DynamicResource CurrentButtonTextColour}"                
                    BorderColor="#000000"
                    BackgroundColor="{DynamicResource CurrentButtonColour}"
                    SemanticProperties.Hint="Counts the number of times you click"

                    HorizontalOptions="Fill"
                    HeightRequest="90" >
                        <Button.GestureRecognizers>
                            <TapGestureRecognizer
                            Tapped="SearchBtn_Tapped"
                            NumberOfTapsRequired="1"/>
                        </Button.GestureRecognizers>
                    </Button>

                    <Button
                                        
                    x:Name="RulesBtn"
                    Style="{StaticResource RuleButtonStyle}"
                    Margin="0, 0, 0, 10"
                    Text="Rules" 
                    FontSize="32"    
                    BorderWidth="2"
                    TextColor="{DynamicResource CurrentButtonTextColour}"                
                    BorderColor="#000000"
                    BackgroundColor="{DynamicResource CurrentButtonColour}"
                    SemanticProperties.Hint="Counts the number of times you click"

                    HorizontalOptions="Fill"
                    HeightRequest="90" >
                        <Button.GestureRecognizers>
                            <TapGestureRecognizer
                            Tapped="SearchBtn_Tapped"
                            NumberOfTapsRequired="1"/>
                        </Button.GestureRecognizers>
                    </Button>
                </FlexLayout>
                </Border>
                <Grid
                    Grid.Row="3"
                    BackgroundColor="#000000"
                    HeightRequest="91"
                    VerticalOptions="End"
                    Style="{StaticResource NavGridStyle}"
                    HorizontalOptions="Fill"
                    >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--<Border
                        Grid.Column="0"
                        VerticalOptions="End"                    
                        HeightRequest="90"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 0,0,0,1"
                        Stroke="#000000"
                        BackgroundColor="#000000"
                        Padding="0 0 1 0"> -->
                    <ImageButton
                    
                        x:Name="NavSpellsBtn"
                        Source="cleric_symbol.png"
                        BackgroundColor="{DynamicResource CurrentNavColour}"
                    
                        Padding="10"
                        Opacity="65"                    
                        SemanticProperties.Hint="Counts the number of times you click"

                        HorizontalOptions="Fill"
                        VerticalOptions="End"                    
                        HeightRequest="90"
                        WidthRequest="100"/>
                    <!--</Border> -->
                    <!--<Border
                        Grid.Column="1"
                        VerticalOptions="End"                    
                        HeightRequest="90"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 0,0,0,1"
                        Stroke="#000000"
                        BackgroundColor="#000000"> -->
                    <ImageButton
                        Grid.Column="1"
                        x:Name="NavClassesBtn"
                        Source="paladin.png"
                        BackgroundColor="{DynamicResource CurrentNavColour}"                   
                        Padding="10"
                        Opacity="65"                    
                        SemanticProperties.Hint="Counts the number of times you click"

                        HorizontalOptions="Fill"
                        VerticalOptions="End"
                        HeightRequest="90" 
                        WidthRequest="100"/>
                    <!--</Border>-->
                    <!--<Border
                    
                        VerticalOptions="End"                    
                        HeightRequest="90"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 0,0,0,1"
                        Stroke="#000000"
                        BackgroundColor="#000000"> -->

                    <ImageButton
                        Grid.Column="2"
                        x:Name="NavEquipmentBtn"
                        Source="fighter_symbol.png"
                        BackgroundColor="{DynamicResource CurrentNavColour}"
                        Padding="10"
                        Opacity="65"
                        SemanticProperties.Hint="Counts the number of times you click"

                        HorizontalOptions="Fill"
                        HeightRequest="90"
                        WidthRequest="100"/>
                    <!--</Border>-->

                    <!--<Border
                    
                        VerticalOptions="End"                    
                        HeightRequest="90"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 0,0,0,1"
                        Stroke="#000000"
                        BackgroundColor="#000000">-->
                    <ImageButton
                        Grid.Column="3"
                        x:Name="NaveRulesBtn"
                        Source="scroll.png"
                        BackgroundColor="{DynamicResource CurrentNavColour}"
                        Padding="10"
                        Opacity="65"                    
                        SemanticProperties.Hint="Counts the number of times you click"

                        HorizontalOptions="Fill"
                        HeightRequest="90"
                        WidthRequest="100"
                        />
                    <!--</Border>-->
                </Grid>
            </Grid>

        </ScrollView>
    </Border>
</ContentPage>

