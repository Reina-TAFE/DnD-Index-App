<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DnD_Index_App.Pages"
             xmlns:vm="clr-namespace:DnD_Index_App.ViewModels"
             x:Class="DnD_Index_App.Pages.ResultsPage"
             x:DataType="local:ResultsPage"
             Title="ResultsPage"
             BackgroundColor="{DynamicResource CurrentBackgroundColour}">
    <VerticalStackLayout>
    <Image 
    FlexLayout.Basis="40"
    FlexLayout.AlignSelf="Center"
    Margin="10 0 5 5"
    x:Name="BackBtn"
    Source="arrow_left.png"
    VerticalOptions="Start"
    HorizontalOptions="Start"
    BackgroundColor="{DynamicResource CurrentBackgroundColour}">
        <Image.GestureRecognizers>
            <TapGestureRecognizer
                    Tapped="BackBtn_Tapped"
                    NumberOfTapsRequired="1"/>
        </Image.GestureRecognizers>
    </Image>
    <ContentView x:Name="ResultsPageWrapper" Content="{Binding ViewModel.PageContent.Content}">

    </ContentView>
    </VerticalStackLayout>
</ContentPage>